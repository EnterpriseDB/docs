{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EDB docs landing page layout (homepage.yaml)",
  "description": "The landing page's groups and sections, links that aren't a product's root page, the banner and the footer links. Products place themselves in a group with `homepage` in their .registry.yaml, and announce what's new with `updates` there.",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "pattern": "^(default|color|logos|flags|edb_logos)/[A-Z][A-Za-z0-9]*$",
      "x-error": "must be written <set>/<Symbol>, where <set> is default, color, logos, flags or edb_logos, e.g. default/Connect"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "heading"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text",
          "description": "What a product's or link's `section` names. Unique within the group."
        },
        "heading": {
          "$ref": "#/$defs/text"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "href": {
          "type": "string"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href",
        "order"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "href": {
          "$ref": "#/$defs/text",
          "description": "A route, or an external URL."
        },
        "order": {
          "type": "number",
          "description": "Sorted with the group's products, which have one too."
        },
        "subtitle": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "description": "The id of a section of this (wide) group."
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "heading",
        "layout"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text",
          "description": "What a product's `homepage.group` names. Unique."
        },
        "heading": {
          "$ref": "#/$defs/text"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "href": {
          "type": "string"
        },
        "layout": {
          "enum": [
            "card",
            "wide"
          ],
          "description": "`card`: a tile in the banner at the top. `wide`: a full-width card, which may have sections."
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      },
      "if": {
        "properties": {
          "layout": {
            "const": "card"
          }
        },
        "required": [
          "layout"
        ]
      },
      "then": {
        "properties": {
          "sections": {
            "not": {},
            "x-error": "a card group has no sections (use a wide group)"
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "groups"
  ],
  "properties": {
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "href": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        }
      }
    },
    "footerLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "href"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/text"
          },
          "href": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "updates": {
      "not": {},
      "x-error": "belongs in the `updates` of the .registry.yaml of the product it describes"
    }
  },
  "additionalProperties": false
}
